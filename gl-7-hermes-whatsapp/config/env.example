# ~/.hermes/.env — copiar para a VPS e preencher. Permissão: chmod 600.
# NUNCA commitar este arquivo preenchido.

# --- Modelo (Anthropic / Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp via bridge Baileys ---
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot

# Quem pode falar com o bot: números com DDI, sem "+" nem espaços, separados por vírgula.
# Durante o PoC: apenas a equipe de teste. Abrir para "*" só após validação.
WHATSAPP_ALLOWED_USERS=55119XXXXXXXX,55119YYYYYYYY

# Grupos: não responder (padrão "pairing" já não encaminha nada de grupos).
WHATSAPP_GROUP_POLICY=pairing

# Diagnóstico (logs brutos em bridge.log). Deixar false no dia a dia.
WHATSAPP_DEBUG=false
